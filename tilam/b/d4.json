  "lines": [
    {"id": "01", "text": "Malaysia ni panas. Bilik tak ada aircond, kipas satu je.",
     "scene": {"comment": {"t": "Malaysia ni hangatt benor, maaf cakap, memang I akan grab semua yg ada perkataan \"cooling\"", "src": "Threads · 2026", "y": 600, "at": 0.1}}},
    {"id": "02", "text": "Tilam pun boleh jadi punca bahang.",
     "scene": {"words": [{"t": "TILAM PUN", "at": 0.05, "size": 120, "y": 660}, {"t": "<b>BAHANG?</b>", "at": "bahang", "size": 160, "y": 830}]}},
    {"id": "03", "text": "Memory foam biasa lebih banyak perangkap haba badan. Lama-lama, rasa panas.",
     "scene": {"items": [{"t": "Memory foam biasa <b>perangkap haba</b>", "x": true, "at": 0.1, "y": 640}, {"t": "Lama-lama <b>rasa panas</b>", "x": true, "at": "Lama", "y": 790}]}},
    {"id": "04", "text": "Coway Prime 2 guna fabrik dengan benang penyejuk dan anti-statik di permukaan.",
     "scene": {"head": {"k": "COWAY PRIME II", "t": "Fabrik <b>penyejuk</b><br>&amp; anti-statik", "y": 160}, "media": {"clip": "cool", "box": [0, 620, 1080, 608]}}},
    {"id": "05", "text": "Dan foam berliang di dalam, supaya udara mengalir, dan kurang haba terperangkap.",
     "scene": {"bg": {"clip": "fabric", "dim": 0.9}, "head": {"k": "DI DALAM", "t": "Foam <b>berliang</b>", "y": 180},
               "chips": [{"t": "Udara mengalir", "at": "udara", "y": 1200}, {"t": "Kurang haba terperangkap", "at": "kurang", "y": 1300}]}},
    {"id": "06", "text": "Jujurnya, tilam bukan aircond. Tapi ia boleh kurangkan rasa bahang.",
     "scene": {"words": [{"t": "JUJURNYA:", "at": 0.05, "size": 90, "y": 560}, {"t": "TILAM ≠ AIRCOND.", "at": "bukan", "size": 104, "y": 710},
                         {"t": "Tapi <b>kurang bahang.</b>", "at": "Tapi", "size": 90, "y": 880, "anim": "up"}]}},
    {"id": "07", "text": "Nak tidur lebih selesa malam ni? WhatsApp saya.",
     "scene": {"cta": {"at": 0.1, "t": "Tidur lebih selesa."}}}
  ]
