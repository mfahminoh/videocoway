{
  "id": "d4", "slug": "bilik-panas-tanpa-aircond", "title": "D4 — Bilik panas tanpa aircond", "pain": ["#160", "#161", "#162"], "mood": "calm", "theme": {"bg": "#0b2427", "bg2": "#1d5157", "accent": "#7fe0c8", "accent2": "#b8f2e2", "ink": "#0b2427"},
