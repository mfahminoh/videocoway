  "lines": [
    {"id": "01", "text": "Mak ayah kita jarang merungut sakit badan.",
     "scene": {"bg": {"img": "assets/tilam/prime2/prime2-panel6-(1).jpg", "pos": "40% 50%", "dim": 1}, "head": {"t": "Mak ayah kita<br><b>jarang merungut</b>", "y": 700}}},
    {"id": "02", "text": "Tapi cuba perhatikan cara diorang bangun pagi. Perlahan. Pegang pinggang.",
     "scene": {"bg": {"img": "assets/tilam/prime2/gallery/darkgrey/side-view-coway-prime2-mattress-dark-grey-series.jpg", "dim": 1},
               "head": {"t": "Cara diorang<br><b>bangun pagi</b>", "y": 200},
               "words": [{"t": "Perlahan.", "at": "Perlahan", "size": 110, "y": 900, "anim": "up"}, {"t": "Pegang <b>pinggang.</b>", "at": "Pegang", "size": 110, "y": 1060, "anim": "up"}]}},
    {"id": "03", "text": "Lepas tu, tengok tilam diorang. Dah berapa tahun? Tengah dah tenggelam?",
     "scene": {"head": {"t": "Tilam diorang<br><b>dah berapa tahun?</b>", "y": 220}, "diagram": "sag",
               "sag": {"topper": false, "at": 0.1, "sagAt": "berapa", "y": 720, "label": "Tengah dah tenggelam?", "topCol": "#ffd9a0"}}},
    {"id": "04", "text": "Diorang takkan minta. Mesti cakap, tak apa, boleh tidur lagi.",
     "scene": {"words": [{"t": "Diorang takkan minta.", "at": 0.05, "size": 74, "y": 520, "anim": "up"},
                         {"t": "“Tak apa…", "at": "tak apa", "size": 120, "y": 760, "anim": "up", "color": "#ffd9a0"},
                         {"t": "boleh tidur lagi.”", "at": "boleh", "size": 110, "y": 910, "anim": "up", "color": "#ffd9a0"}]}},
    {"id": "05", "text": "Jadi kali ni, biar kita yang pilihkan.",
     "scene": {"bg": {"img": "assets/tilam/prime2/prime2-panel3-desktop.jpg", "pos": "55% 50%", "dim": 1}, "head": {"t": "Kali ni,<br><b>biar kita pilihkan</b>", "y": 700}}},
    {"id": "06", "text": "Coway Prime 2. Pocket spring tujuh zon, latex asli, dan topper yang boleh ditukar.",
     "scene": {"head": {"k": "COWAY PRIME II", "t": "Sokongan<br><b>setiap malam</b>", "y": 160}, "media": {"clip": "support", "box": [0, 600, 1080, 608]},
               "chips": [{"t": "Pocket spring 7 zon", "at": "Pocket", "y": 1240}, {"t": "Latex asli", "at": "latex", "y": 1340}, {"t": "Topper boleh ditukar", "at": "topper", "y": 1440}]}},
    {"id": "07", "text": "Pilih Soft kalau suka tidur mengiring, Firm kalau tidur terlentang.",
     "scene": {"head": {"t": "<b>Soft</b> atau <b>Firm</b>?", "s": "Ikut cara mak ayah tidur", "y": 170},
               "media": {"img": "assets/tilam/prime2/firm-soft-mattress-for-all-sleepers-coway-prime2-series.jpg", "box": [0, 520, 1080, 608]},
               "chips": [{"t": "Soft · tidur mengiring", "at": "Soft", "y": 1200}, {"t": "Firm · tidur terlentang", "at": "Firm", "y": 1310}]}},
    {"id": "08", "text": "Dengan servis penjagaan tilam berkala, mak ayah tak perlu susah-susah cuci tilam.",
     "scene": {"head": {"t": "Servis penjagaan<br><b>berkala</b>", "y": 170}, "media": {"img": "assets/tilam/prime2/coway-7-step-mattress-care-service-prime2.png", "box": [90, 560, 900, 597]},
               "chips": [{"t": "Mak ayah tak perlu cuci sendiri", "at": "tak perlu", "y": 1260}]}},
    {"id": "09", "text": "Hadiah yang mak ayah guna setiap malam. WhatsApp saya, kita pilih sama-sama.",
     "scene": {"cta": {"at": 0.1, "img": "assets/tilam/prime2/prime2-panel6-(1).jpg", "t": "Hadiah yang diguna setiap malam."}}}
  ]
}
