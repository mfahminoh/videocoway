    {"id": "05", "text": "Prime 2 lain sikit. Topper dia memang sebahagian dari tilam, dan boleh ditukar.",
     "scene": {"head": {"k": "COWAY PRIME II", "t": "Topper <b>boleh ditukar</b>", "y": 180}, "media": {"clip": "topper", "box": [0, 610, 1080, 608]}}},
    {"id": "06", "text": "Struktur bawah kekal padu, lapisan atas boleh diganti.",
     "scene": {"cont": true, "chips": [{"t": "Struktur bawah kekal padu", "at": "Struktur", "y": 1270}, {"t": "Lapisan atas diganti 3 tahun sekali*", "at": "lapisan", "y": 1375}],
