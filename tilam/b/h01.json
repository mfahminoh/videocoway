{
  "id": "h01", "slug": "topper-fabrik-sejuk-gebu-macam-hotel", "title": "H01 — Emosi + explainer: fabrik penyejuk & foam topper, rasa sejuk dan gebu macam tilam hotel",
  "pain": ["#160", "#161", "#162", "#73"], "mood": "warm",
  "product": {"name": "TILAM <b>COWAY</b>", "sub": "Prime Lite · Prime II · Elite", "img": "assets/tilam/elite/new-home-banner.jpg", "ctaSize": 96},
  "clips": {"cool": {"src": "assets/tilam/elite/video/coolingloop.mp4", "from": 0.0, "to": 5.0}},
  "lines": [
    {"id": "01", "text": "Seharian kerja. Balik rumah, masak, uruskan anak, kemas rumah. Bila semua dah tidur, baru kita dapat baring.",
     "scene": {"bg": {"img": "assets/tilam/jana/ht_a_ibu_penat.jpg", "dim": 0.9},
               "head": {"k": "PERNAH RASA?", "t": "Penat <b>seharian…</b>", "y": 190},
               "words": [{"t": "baru dapat baring.", "at": "Bila", "size": 66, "y": 470, "anim": "up"}]}},
    {"id": "02", "text": "Tapi badan berpeluh. Tilam rasa panas. Pusing kiri, pusing kanan, mata tetap tak lena.",
     "scene": {"bg": {"img": "assets/tilam/jana/ht_b_malam_panas.jpg", "dim": 0.9},
               "words": [{"t": "BERPELUH.", "at": "berpeluh", "size": 110, "y": 230}, {"t": "PANAS.", "at": "panas", "size": 110, "y": 370},
                         {"t": "<b>TAK LENA.</b>", "at": "tak lena", "size": 130, "y": 510}]}},
    {"id": "03", "text": "Lain betul masa kita bercuti dulu. Baring je atas katil hotel, rasa sejuk, rasa gebu, terus lena sampai pagi.",
     "scene": {"bg": {"img": "assets/tilam/jana/ht_c_kenangan_hotel.jpg", "dim": 0.9, "kb": "out"},
               "head": {"k": "INGAT LAGI?", "t": "Tilam hotel:<br><b>sejuk &amp; gebu</b>", "y": 190, "at": "Baring"}}},
    {"id": "04", "text": "Kenapa tilam hotel boleh rasa macam tu, tapi tilam kat rumah tak?",
     "scene": {"words": [{"t": "KENAPA", "at": 0.05, "size": 110, "y": 600}, {"t": "TILAM HOTEL", "at": "tilam hotel", "size": 110, "y": 740},
                         {"t": "rasa <b>lain?</b>", "at": "rumah", "size": 140, "y": 900}]}},
    {"id": "05", "text": "Rahsianya pada dua lapisan paling atas. Fabrik yang kita sentuh, dan foam topper di bawahnya.",
     "scene": {"head": {"k": "RAHSIANYA", "t": "2 lapisan<br><b>paling atas</b>", "y": 170},
               "springs": [{"y": 520, "h": 520, "H": 200, "mode": "pocket", "n": 11, "topper": {"t": 90, "dim": true},
                            "tags": [{"t": "1 · Fabrik", "x": 560, "y": 92, "at": "Fabrik"}, {"t": "2 · Foam topper", "x": 470, "y": 214, "at": "foam topper"}]}]}},
    {"id": "06", "text": "Mula dengan fabrik. Fabrik biasa simpan haba badan. Haba terkumpul, lepas tu terasa balik ke badan. Makin lama, makin panas.",
     "scene": {"head": {"k": "1 · FABRIK", "t": "Fabrik biasa<br><b>simpan haba</b>", "y": 170},
               "heat": [{"y": 500, "h": 560, "mode": "biasa", "label": "FABRIK BIASA", "at": "Fabrik biasa",
                         "tags": [{"t": "Haba terperangkap", "bad": true, "at": "terkumpul", "y": 600}]}]}},
    {"id": "07", "text": "Fabrik penyejuk lain. Ia ditenun dengan benang penyejuk, jadi haba disebarkan keluar dan permukaan tilam kekal lebih sejuk.",
     "scene": {"head": {"k": "1 · FABRIK", "t": "Fabrik <b>penyejuk</b>", "y": 170},
               "heat": [{"y": 420, "h": 560, "mode": "sejuk", "label": "FABRIK PENYEJUK", "coolAt": "benang penyejuk",
                         "tags": [{"t": "Haba disebar keluar", "at": "disebarkan", "y": 600}]}]}},
    {"id": "08", "text": "Kedua, foam topper. Inilah lapisan yang buat tilam rasa gebu.",
     "scene": {"head": {"k": "2 · FOAM TOPPER", "t": "Lapisan yang<br>buat <b>gebu</b>", "y": 170},
               "springs": [{"y": 560, "h": 520, "H": 200, "mode": "pocket", "n": 11, "topper": {"t": 100, "k": 0.85, "dim": true},
                            "loads": [{"k": "block", "x": 500, "w": 240, "d": 90, "at": "Inilah", "drop": 150, "label": "TEKAN"}]}]}},
    {"id": "09", "text": "Kalau topper terlalu nipis, badan cepat terasa lapisan keras di bawah. Bahu dan pinggul rasa tertekan.",
     "scene": {"head": {"k": "NIPIS vs TEBAL", "t": "Tebal topper<br><b>beri kesan</b>", "y": 150},
               "springs": [{"y": 430, "h": 500, "H": 170, "mode": "pocket", "n": 17, "label": "TOPPER NIPIS", "topper": {"t": 20, "k": 0.3, "dim": true, "dimCol": "var(--red)"},
                            "body": {"at": "nipis", "hot": [{"x": 300, "at": "Bahu"}, {"x": 590, "at": "pinggul"}]},
                            "tags": [{"t": "Tertekan", "bad": true, "at": "tertekan"}]}]}},
    {"id": "10", "text": "Topper yang cukup tebal pula peluk badan dengan lembut, dan spring di bawah masih menyokong. Itulah rasa gebu macam hotel.",
     "scene": {"cont": true,
               "springs": [{"y": 970, "h": 500, "H": 150, "mode": "pocket", "n": 17, "label": "TOPPER TEBAL", "at": 0.05, "topper": {"t": 95, "k": 0.8, "dim": true, "dimCol": "#3ccf7a"},
                            "body": {"at": "tebal"},
                            "tags": [{"t": "Gebu, tetap disokong", "at": "Itulah"}]}]}},
    {"id": "11", "text": "Dan bila foam tu berliang, udara boleh mengalir. Haba tak terperangkap dalam tilam.",
     "scene": {"head": {"k": "BONUS", "t": "Foam <b>berliang</b>", "y": 170},
               "heat": [{"y": 440, "h": 560, "mode": "foam", "label": "FOAM BERLIANG", "src": "UDARA KELUAR · HABA BAWA PERGI",
                         "tags": [{"t": "Udara mengalir", "at": "udara", "y": 600}]}]}},
    {"id": "12", "text": "Fabrik penyejuk dan topper yang gebu, inilah yang ada dalam setiap tilam Coway.",
     "scene": {"bg": {"clip": "cool", "dim": 0.75},
               "words": [{"t": "FABRIK PENYEJUK", "at": "Fabrik", "size": 96, "y": 560}, {"t": "+ TOPPER GEBU", "at": "topper", "size": 96, "y": 690},
                         {"t": "dalam setiap tilam <b>Coway</b>", "at": "setiap", "size": 72, "y": 880, "anim": "up"}]}},
    {"id": "13", "text": "Prime Lite, tebal tiga puluh setengah sentimeter, fabrik penyejuk dengan topper zip. Prime 2, tiga puluh tiga sentimeter, fabrik sejuk dan anti-statik.",
     "scene": {"head": {"k": "KETEBALAN TILAM", "t": "Pilih ikut <b>rasa</b>", "y": 150, "size": 76},
               "lineup": [{"name": "Prime Lite", "big": "30.5", "unit": "CM", "sub": "Fabrik penyejuk<br>Topper zip boleh tanggal", "img": "assets/tilam/primelite/prime-lite-panel1-desktop.jpg", "pos": "62% 65%", "at": "Prime Lite"},
                          {"name": "Prime II", "big": "33", "unit": "CM", "sub": "Fabrik sejuk &amp; anti-statik<br>Topper boleh tukar", "img": "assets/tilam/prime2/prime2-panel3-desktop.jpg", "pos": "62% 60%", "at": "Prime 2"},
                          {"name": "Elite", "big": "36", "unit": "CM", "sub": "Plush top premium<br>Fabrik sejuk + Sanitized®", "img": "assets/tilam/elite/latest-gallery2.png", "pos": "70% 60%", "at": "14:Elite"}]}},
    {"id": "14", "text": "Dan Elite, tiga puluh enam sentimeter, dengan plush top premium untuk rasa paling mewah.",
     "scene": {"cont": true}},
    {"id": "15", "text": "Untuk pelanggan sewa, topper ditukar baru pada tahun ketiga. Jadi rasa gebu tu kekal.",
     "scene": {"head": {"k": "RASA GEBU KEKAL", "t": "Topper <b>ditukar baru</b>", "s": "Tahun ke-3 · pelanggan sewa", "y": 170},
               "media": {"img": "assets/tilam/primelite/white-mattress-topper-getting-unzipped-from-a-blue-mattress-to-get-changed.jpg", "box": [60, 560, 960, 720]}}},
    {"id": "16", "text": "Sebab you dah penat seharian. Waktu tidur, you layak rasa macam bercuti.",
     "scene": {"bg": {"img": "assets/tilam/jana/ht_d_lena_rumah.jpg", "dim": 0.9},
               "head": {"t": "Malam you,<br><b>macam bercuti.</b>", "y": 200, "at": "Waktu"}}},
    {"id": "17", "text": "Nak rasa sendiri beza dia? WhatsApp saya.",
     "scene": {"cta": {"at": 0.1, "t": "Tanya dulu. Saya terangkan beza setiap satu."}}}
  ]
}
