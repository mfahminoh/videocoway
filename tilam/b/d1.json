{
  "id": "d1", "slug": "anak-terkencing-atas-tilam", "title": "D1 — Anak terkencing atas tilam", "pain": ["#85", "#87", "#91", "#92"], "mood": "warm", "theme": {"bg": "#0b2427", "bg2": "#1d5157", "accent": "#7fe0c8", "accent2": "#b8f2e2", "ink": "#0b2427"},
  "lines": [
    {"id": "01", "text": "Anak terkencing atas tilam. Basuh macam mana ni?",
     "scene": {"comment": {"t": "Kalau anak terkencing atas tilam, korang biasanya cuci macam mana?", "src": "Threads · 2025", "y": 600, "at": 0.1}}},
    {"id": "02", "text": "Ramai mak ayah lalui benda ni. Lagi-lagi masa potty training.",
     "scene": {"words": [{"t": "MASA <b>POTTY TRAINING</b>", "at": 0.05, "size": 92, "y": 660}, {"t": "memang biasa jadi.", "at": "Lagi", "size": 64, "y": 820, "anim": "up"}]}},
    {"id": "03", "text": "Langkah pertama, jangan basahkan tilam. Serap dulu dengan tuala kering.",
     "scene": {"head": {"k": "3 LANGKAH", "t": "Bila anak <b>terkencing</b>", "y": 180},
               "items": [{"t": "<b>Serap</b> dengan tuala kering, jangan basahkan", "icon": "1", "at": "Langkah", "y": 560}]}},
    {"id": "04", "text": "Lepas tu, biar kering sepenuhnya. Lembapan yang terperangkap boleh jadi kulat dan bau.",
     "scene": {"cont": true, "items": [{"t": "Biar <b>kering sepenuhnya</b>, elak kulat & bau", "icon": "2", "at": "Lepas", "y": 730}]}},
    {"id": "05", "text": "Dan guna pelindung tilam kalis air, terutamanya untuk anak kecil.",
     "scene": {"cont": true, "items": [{"t": "Guna <b>pelindung kalis air</b>", "icon": "3", "at": "pelindung", "y": 900}]}},
    {"id": "06", "text": "Dengan Coway Prime 2, ada servis penjagaan tilam berkala. Technician datang, bersihkan tilam, sembur penghalau hama, dan sterilisasi UV.",
     "scene": {"head": {"k": "COWAY PRIME II", "t": "Servis penjagaan<br><b>berkala</b>", "y": 160}, "media": {"img": "assets/tilam/prime2/step-5-mattress-cleaning-services-mattress-cleaning-coway-prime2.jpg", "box": [90, 560, 900, 586]},
               "chips": [{"t": "Bersihkan tilam", "at": "bersihkan", "y": 1200}, {"t": "Penghalau hama", "at": "penghalau", "y": 1300}, {"t": "Sterilisasi UV", "at": "UV", "y": 1400}]}},
    {"id": "07", "text": "Jadi kebersihan tilam terus terjaga, walaupun rumah ada anak kecil.",
     "scene": {"words": [{"t": "Rumah ada <b>anak kecil?</b>", "at": "walaupun", "size": 84, "y": 700, "anim": "up"}, {"t": "Tilam tetap <b>terjaga.</b>", "at": 0.05, "size": 96, "y": 560}]}},
    {"id": "08", "text": "Nak tahu lebih lanjut tentang servis tilam? WhatsApp saya.",
     "scene": {"cta": {"at": 0.1, "img": "assets/tilam/prime2/prime2-panel4-desktop.jpg", "t": "Tanya pasal servis tilam."}}}
  ]
}
